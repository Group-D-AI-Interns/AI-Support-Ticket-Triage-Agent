    {
      "name": "4 — MANUAL review decisions (run individually)",
      "description": "Inspect the original document, quotation and candidate first. These requests change governance state. Do not run the whole collection unattended. Choose approve OR reject. Publication selects ruleId only; choose additional approved IDs explicitly if needed. support_staff deliberately shares approved excerpts with permitted support staff; administrators preserves restricted visibility.",
      "item": [
        {
          "name": "Approve inspected candidate",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
