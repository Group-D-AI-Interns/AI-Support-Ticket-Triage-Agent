# Node/TypeScript shared API. These values are local-development defaults.
NODE_ENV=development
# Bind loopback for host-local development; use the container/platform's required interface when hosted.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
AUTH_MODE=keycloak
# Local realm issuer (set the exact HTTPS issuer in hosted environments).
AUTH_ISSUER=http://localhost:8081/realms/ai-support
AUTH_AUDIENCE=support-api
# Optional. Otherwise the OIDC discovery document supplies the realm JWKS URI.
AUTH_JWKS_URI=
# Optional. Required only for POST /api/v1/users invitations. Use a Keycloak
# confidential service account with least-privilege realm user-management roles.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
DATA_DIRECTORY=./.local-data
JSON_WRITE_LOCK_TIMEOUT_MS=5000
# In-process SLA reevaluation interval (five minutes by default).
SLA_EVALUATION_INTERVAL_MS=300000

# The shared startup mounts the Node/TypeScript foundation and Express domain
# modules in one server. Ticket requests use Keycloak plus active local membership.

# AI provider configuration
TICKET_AI_DEMO_ENABLED=false
TICKET_AI_LIVE_ENABLED=false
TICKET_AI_CATEGORIES=
TICKET_AI_CLASSIFICATION_PROVIDER=inception
TICKET_AI_SUMMARIZATION_PROVIDER=inception
GROQ_API_KEY=
INCEPTION_API_KEY=
MISTRAL_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3
INCEPTION_MAX_RETRIES=2
INCEPTION_BACKOFF_BASE_SECONDS=1
INCEPTION_BACKOFF_MAX_SECONDS=8
LLM_CALL_TIMEOUT_SECONDS=20
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Draft priority API preview. Disabled by default; requires APP_ENV=development.
# Also enable an existing demo/live AI runtime. Live uses its classification provider.
TICKET_PRIORITY_PREVIEW_ENABLED=false
# Explicit reviewed threshold required when enabled; no calibrated default is assumed.
TICKET_PRIORITY_MIN_CONFIDENCE=
