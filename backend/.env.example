NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
AUTH_MODE=keycloak
# Shared development realm (must exactly match the deployed issuer and audience).
AUTH_ISSUER=http://localhost:8081/realms/ai-support
AUTH_AUDIENCE=support-api
# Optional. Otherwise the OIDC discovery document supplies the realm JWKS URI.
AUTH_JWKS_URI=
# Optional. Required only for POST /api/v1/users invitations. Use a Keycloak
# confidential service account with least-privilege realm user-management roles.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
DATA_DIRECTORY=./.local-data
JSON_WRITE_LOCK_TIMEOUT_MS=5000
