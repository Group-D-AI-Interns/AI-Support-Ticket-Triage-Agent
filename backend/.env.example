# Node/TypeScript shared API. These values are local-development defaults.
NODE_ENV=development
# Bind loopback for host-local development; use the container/platform's required interface when hosted.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
AUTH_MODE=keycloak
# Local realm issuer (set the exact HTTPS issuer in hosted environments).
AUTH_ISSUER=http://localhost:8081/realms/ai-support
AUTH_AUDIENCE=support-api
# Optional. Otherwise the OIDC discovery document supplies the realm JWKS URI.
AUTH_JWKS_URI=
# Optional. Required only for POST /api/v1/users invitations. Use a Keycloak
# confidential service account with least-privilege realm user-management roles.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
DATA_DIRECTORY=./.local-data
JSON_WRITE_LOCK_TIMEOUT_MS=5000

# This file configures backend/src/server.ts only. The separate Python ticket
# app is not yet wired into the shared server or this environment contract.
