    "test": "node --test --test-concurrency=1 --import tsx ./tests/**/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.5.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
