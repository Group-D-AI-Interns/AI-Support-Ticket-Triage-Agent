
{
  "name": "ai-support-ticket-triage-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend foundation for the AI Support Ticket Triage Agent",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --project tsconfig.source.json",
    "test": "node --test --test-concurrency=1 --import tsx ./tests/**/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.5.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
